# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# generated illustration sources — outputs live in public/img
/assets-src

# local agent tooling, not part of the product
/.claude
/.mcp.json

# agent instruction files, regenerated by `next dev`
/CLAUDE.md
/AGENTS.md

# working notes — kept locally, not part of the app
/SUBMISSION.md
/CODEX.md
